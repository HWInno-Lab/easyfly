 // Provide output format for LiDAR-visual BA
+void LIVMapper::publishAtlasFrame()
+{
+  if(!atlas_keyframes_enabled_) return;
+  const auto scan = atlas_scan_.take(LidarMeasures.last_lio_update_time);
+  if(scan.empty() ||
+     p_imu->imu_need_init || vio_manager->patch_size_total <= 0 ||
+     vio_manager->accepted_residuals / vio_manager->patch_size_total < 8 ||
+     scan.size() < 100 || scan.size() > 200000)
+    return;
+  // This runs immediately after the post-visual odometry update. Reproject
+  // the original deskewed full scan with that same native state, rather than
+  // reuse pre-visual world points or the camera-cropped visualization cloud.
+  PointCloudXYZI world;
+  world.resize(scan.size());
+  for(size_t i=0; i<world.size(); ++i) {
+    RGBpointBodyToWorld(&scan.points[i], &world.points[i]);
+    if(!std::isfinite(world.points[i].x) || !std::isfinite(world.points[i].y) ||
+       !std::isfinite(world.points[i].z))
+      return;
+  }
+  sensor_msgs::msg::PointCloud2 message;
+  pcl::toROSMsg(world, message);
+  message.header = odomAftMapped.header;
+  atlas_odometry_->publish(odomAftMapped);
+  atlas_cloud_->publish(message);
+}
