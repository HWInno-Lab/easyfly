+void System::UseLoadedAtlasForLocalization()
+{
+    if(mStrLoadAtlasFromFile.empty()) throw std::runtime_error("no atlas was loaded");
+    mpLocalMapper->RequestStop();
+    while(!mpLocalMapper->isStopped()) usleep(1000);
+    Map* selected = nullptr;
+    for(Map* map : mpAtlas->GetAllMaps())
+        if(!map->IsBad() && (!selected || map->KeyFramesInMap()>selected->KeyFramesInMap())) selected=map;
+    if(!selected || selected->KeyFramesInMap()<2) throw std::runtime_error("loaded atlas has insufficient keyframes");
+    mpAtlas->ChangeMap(selected);
+    mpTracker->PrepareLoadedMap();
+}
+
+void System::UseLoadedAtlasForInertialMapping()
+{
+    if(mSensor != IMU_RGBD || mStrLoadAtlasFromFile.empty())
+        throw std::runtime_error("inertial atlas continuation requires IMU_RGBD and a loaded atlas");
+    Map* selected = nullptr;
+    for(Map* map : mpAtlas->GetAllMaps())
+        if(!map->IsBad() && map->IsInertial() && map->isImuInitialized() &&
+           map->GetIniertialBA2() && (!selected || map->KeyFramesInMap()>selected->KeyFramesInMap()))
+            selected = map;
+    if(!selected || selected->KeyFramesInMap()<10)
+        throw std::runtime_error("no completed inertial reference map with ten keyframes");
+    if(!settings_ || !settings_->camera1())
+        throw std::runtime_error("inertial atlas requires explicit camera and IMU calibration");
+    const float frequencyScale = std::sqrt(settings_->imuFrequency());
+    const IMU::Calib expected(settings_->Tbc(), settings_->noiseGyro()*frequencyScale,
+        settings_->noiseAcc()*frequencyScale, settings_->gyroWalk()/frequencyScale,
+        settings_->accWalk()/frequencyScale);
+    for(KeyFrame* kf : selected->GetAllKeyFrames())
+    {
+        if(!kf || kf->isBad()) continue;
+        if(!kf->bImu || !kf->mImuCalib.mbIsSet || !kf->mpCamera ||
+           kf->mpCamera->GetType()!=settings_->camera1()->GetType() ||
+           kf->mpCamera->size()!=settings_->camera1()->size() ||
+           !kf->mImuCalib.mTbc.matrix().isApprox(expected.mTbc.matrix(), 1e-6f) ||
+           !kf->mImuCalib.Cov.diagonal().isApprox(expected.Cov.diagonal(), 1e-5f) ||
+           !kf->mImuCalib.CovWalk.diagonal().isApprox(expected.CovWalk.diagonal(), 1e-5f))
+            throw std::runtime_error("stored inertial keyframe calibration mismatch");
+        for(size_t i=0; i<kf->mpCamera->size(); ++i)
+            if(std::abs(kf->mpCamera->getParameter(i)-settings_->camera1()->getParameter(i))>1e-5f)
+                throw std::runtime_error("stored keyframe camera calibration mismatch");
+    }
+    for(KeyFrame* kf : selected->GetAllKeyFrames())
+        if(kf && !kf->isBad()) mLoadedReferenceKeyframes.insert(kf);
+    mLoadedReferenceMap = selected->GetId();
+    // Keep the fresh active map created by the native constructor. The new
+    // IMU sequence must initialize and geometrically merge with real old KFs.
+    // Do not resurrect old frame velocities/preintegrations or enter the
+    // upstream unsupported inertial localization-only path.
+}
+
+bool System::GetConditionalInertialInformation(Eigen::Matrix<double,15,15>& information,
+                                               Eigen::Matrix3d& Rwb)
+{
+    if(mSensor != IMU_RGBD || mpTracker->mState != Tracking::OK ||
+       !mpTracker->mCurrentFrame.mpcpi) return false;
+    information = mpTracker->mCurrentFrame.mpcpi->H;
+    Rwb = mpTracker->mCurrentFrame.GetImuRotation().cast<double>();
+    return information.allFinite() && Rwb.allFinite();
+}
