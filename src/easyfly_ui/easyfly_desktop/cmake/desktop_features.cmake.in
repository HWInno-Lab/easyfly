include(CMakeFindDependencyMacro)
find_dependency(Qt5 COMPONENTS Core Gui Widgets)
find_dependency(SQLite3)
find_dependency(PkgConfig)
pkg_check_modules(GEOGRAPHICLIB REQUIRED IMPORTED_TARGET geographiclib)
set(easyfly_desktop_HAS_MEDIA @EASYFLY_ENABLE_MEDIA@)
set(easyfly_desktop_HAS_RVIZ_EMBED @EASYFLY_ENABLE_RVIZ_EMBED@)
if(easyfly_desktop_HAS_MEDIA)
  find_dependency(OpenCV 4 COMPONENTS core imgproc imgcodecs videoio)
endif()
if(easyfly_desktop_HAS_RVIZ_EMBED)
  find_dependency(rviz_common 11.2.26 EXACT)
  find_dependency(rviz_rendering 11.2.26 EXACT)
  find_dependency(rviz_default_plugins 11.2.26 EXACT)
  find_dependency(easyfly_rviz_plugins)
endif()
