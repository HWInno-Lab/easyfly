  <name>easyfly_perception_contracts</name><version>0.1.0</version>
  <description>Versioned perception admission, identity and compatibility at the ROS boundary.</description>
  <maintainer email="dev@easyfly.local">EasyFly</maintainer><!-- Listed own code is offered only under the EasyFly license; retained third-party materials have separate terms. -->
