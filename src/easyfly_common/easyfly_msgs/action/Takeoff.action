# 起飞
float64 target_altitude   # 目标高度 [m] (相对起飞点)
float64 climb_speed       # 爬升速度 [m/s], 0=默认
---
# 结果
bool success
string message
---
# 反馈
float64 current_altitude  # 当前高度 [m]
float32 progress          # 进度 [0.0-1.0]
