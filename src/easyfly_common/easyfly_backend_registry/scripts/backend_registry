import argparse
import json
from easyfly_backend_registry import Registry, read

parser = argparse.ArgumentParser(description='Inspect metadata or validate configuration; never starts algorithms.')
parser.add_argument('operation', choices=['list', 'validate', 'check-source'])
parser.add_argument('--config')
parser.add_argument('--profile')
parser.add_argument('--source-root')
args = parser.parse_args()
registry = Registry()
if args.operation == 'check-source':
    if not args.source_root: parser.error('--source-root is required')
    print(json.dumps(registry.check_source_tree(args.source_root), indent=2))
elif args.operation == 'validate':
    if not args.config:
        parser.error('--config is required')
    print(json.dumps(registry.validate(read(args.config), profile=args.profile), ensure_ascii=False, indent=2))
else:
    print(json.dumps({'schema_version': 1, 'scope': 'metadata only; not runtime readiness',
                      'backends': list(registry.entries.values())}, ensure_ascii=False, indent=2))
