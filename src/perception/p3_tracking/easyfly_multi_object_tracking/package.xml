<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_multi_object_tracking</name>
  <version>0.1.0</version>
  <description>ROS tracking integration and adapters for independent tracking algorithms.</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <!-- Listed own code is offered only under the EasyFly license; retained third-party materials have separate terms. -->
  <license>LicenseRef-EasyFly-Restricted-1.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>easyfly_perception_contracts</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp_components</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>easyfly_msgs</depend>
  <depend>std_srvs</depend>
  <depend>easyfly_tracking_api</depend>
  <build_depend>easyfly_sort</build_depend>
  <build_depend>easyfly_track_id_fusion</build_depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>easyfly_pixel_to_3d</test_depend>
  <test_depend>tf2_ros_py</test_depend>
  <test_depend>python3-yaml</test_depend>

  <exec_depend>easyfly_launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <depend>easyfly_backend_registry</depend>
  <depend>diagnostic_msgs</depend>
</package>
