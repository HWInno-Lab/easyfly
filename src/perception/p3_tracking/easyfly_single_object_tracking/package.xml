<?xml version="1.0"?>
<package format="3">
  <name>easyfly_single_object_tracking</name><version>0.1.0</version>
  <description>Independent bounded single_object_tracking perception; no flight control</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>sensor_msgs</depend><depend>easyfly_msgs</depend>
  <depend>opencv</depend>
  <depend>easyfly_csrt</depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend><test_depend>rclpy</test_depend>
  <test_depend>ament_lint_auto</test_depend><test_depend>ament_lint_common</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
