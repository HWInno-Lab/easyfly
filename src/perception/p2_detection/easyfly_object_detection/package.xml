<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_object_detection</name>
  <version>0.1.0</version>
  <description>EasyFly P2: 通用目标检测 (YOLO11 ONNX, OnnxRuntime GPU, 后端可扩展)</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>easyfly_detection_api</depend>
  <depend>easyfly_yolo_onnx</depend>
  <depend>rclcpp_components</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>easyfly_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>easyfly_launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
