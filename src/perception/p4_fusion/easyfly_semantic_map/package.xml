<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_semantic_map</name>
  <version>0.1.0</version>
  <description>
    EasyFly P4: 滤波点云 → 障碍表征 (M4.0)。
    欧式聚类 → /obstacles (ObstacleInfoArray) + /get_obstacles srv
    + 2D 占据栅格 /occupancy_grid (供 M4.2 全局规划) + RViz markers。
  </description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>
  <depend>easyfly_obstacle_association</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>easyfly_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_cppcheck</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>gdb</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
