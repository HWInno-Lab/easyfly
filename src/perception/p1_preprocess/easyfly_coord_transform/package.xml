<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_coord_transform</name>
  <version>0.1.0</version>
  <description>EasyFly P1: odom→base_link 动态 TF + 坐标变换工具库 (ENU/FLU/光学系)</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>easyfly_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>easyfly_rc_receiver</test_depend>
  <test_depend>mavros_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>easyfly_launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
