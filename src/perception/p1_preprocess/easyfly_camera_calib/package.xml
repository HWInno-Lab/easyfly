<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_camera_calib</name>
  <version>0.1.0</version>
  <description>EasyFly P1: 传感器内外参管理 (YAML) + 静态 TF 发布 + 内参校验</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>ament_index_cpp</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <exec_depend>rclpy</exec_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>ament_index_python</test_depend>

  <exec_depend>easyfly_launch</exec_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
