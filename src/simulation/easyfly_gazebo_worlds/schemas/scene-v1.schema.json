{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "registered"
      ]
    },
    "category": {
      "enum": [
        "indoor/warehouse",
        "indoor/residential",
        "indoor/office",
        "indoor/hospital",
        "indoor/commercial",
        "outdoor/urban",
        "outdoor/forest",
        "outdoor/agriculture",
        "outdoor/terrain",
        "benchmark/navigation",
        "benchmark/perception",
        "benchmark/landing"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "simulator": {
      "const": "gazebo_classic"
    },
    "world": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "package",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "recorded"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "declared_license": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "package": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "package",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "external": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "external",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "source_url",
        "revision",
        "declared_license",
        "evidence",
        "note"
      ],
      "additionalProperties": false
    },
    "asset_sets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "required_plugins": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supported_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "legacy_profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "spawn": {
      "type": "object",
      "properties": {
        "frame": {
          "const": "world"
        },
        "position": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "yaw": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "frame",
        "position",
        "yaw",
        "basis"
      ],
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "properties": {
        "frame": {
          "const": "odom"
        },
        "world_to_navigation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "translation": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "yaw": {
                  "type": "number"
                }
              },
              "required": [
                "translation",
                "yaw"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_region": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "max": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "ground_model_frame": {
          "type": "string",
          "enum": [
            "map",
            "odom"
          ]
        }
      },
      "required": [
        "frame",
        "world_to_navigation",
        "recommended_region"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "entrypoint": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "package": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                }
              },
              "required": [
                "package",
                "path"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "external": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                }
              },
              "required": [
                "external",
                "path"
              ],
              "additionalProperties": false
            }
          ]
        },
        "asset_sets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "required_plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "additional_files": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "package": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "package",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "external": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "external",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "entrypoint",
        "asset_sets",
        "required_plugins",
        "additional_files",
        "notes"
      ],
      "additionalProperties": false
    },
    "recommended_missions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "package": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              }
            },
            "required": [
              "package",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "external": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              }
            },
            "required": [
              "external",
              "path"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "map_products": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "package": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              }
            },
            "required": [
              "package",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "external": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              }
            },
            "required": [
              "external",
              "path"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "resources_complete": {
          "type": "boolean"
        },
        "world_loaded": {
          "type": "boolean"
        },
        "sensors_checked": {
          "type": "boolean"
        },
        "navigation_tested": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "package": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "package",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "external": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "external",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "resources_complete",
        "world_loaded",
        "sensors_checked",
        "navigation_tested",
        "evidence_refs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "category",
    "tags",
    "simulator",
    "world",
    "provenance",
    "asset_sets",
    "required_plugins",
    "supported_profiles",
    "legacy_profiles",
    "spawn",
    "navigation",
    "runtime",
    "recommended_missions",
    "map_products",
    "verification"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
