{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "asset_set_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "model_root": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          },
          "required": [
            "package",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "external": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          },
          "required": [
            "external",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "recorded"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "declared_license": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "package": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "package",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "external": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "external",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "source_url",
        "revision",
        "declared_license",
        "evidence",
        "note"
      ],
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sdf": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "unverified",
                  "recorded"
                ]
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "declared_license": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "package": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                        }
                      },
                      "required": [
                        "package",
                        "path"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "external": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                        }
                      },
                      "required": [
                        "external",
                        "path"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "source_url",
              "revision",
              "declared_license",
              "evidence",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "sdf",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "local_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "storage": {
      "enum": [
        "existing",
        "vendored",
        "cached"
      ]
    },
    "inventory_note": {
      "type": "string",
      "minLength": 1
    },
    "archive": {
      "type": "object",
      "properties": {
        "format": {
          "const": "tar.gz"
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "max_members": {
          "type": "integer",
          "minimum": 1
        },
        "max_unpacked_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "license": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "source",
            "sha256"
          ],
          "additionalProperties": false
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "replacements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "old": {
                      "type": "string",
                      "minLength": 1
                    },
                    "new": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "old",
                    "new",
                    "count"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "source",
              "target",
              "source_sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "urls",
        "sha256",
        "size_bytes",
        "prefix",
        "max_members",
        "max_unpacked_bytes",
        "license",
        "members"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "asset_set_id",
    "model_root",
    "provenance",
    "models",
    "files",
    "local_changes",
    "storage",
    "inventory_note"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "const": "cached"
          }
        }
      },
      "then": {
        "required": [
          "archive"
        ],
        "properties": {
          "model_root": {
            "const": {
              "external": "asset_cache",
              "path": "models"
            }
          }
        }
      }
    }
  ]
}
