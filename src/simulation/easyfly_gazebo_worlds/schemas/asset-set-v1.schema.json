{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "asset_set_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "model_root": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          },
          "required": [
            "package",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "external": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          },
          "required": [
            "external",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "recorded"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "declared_license": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "package": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "package",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "external": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "external",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "source_url",
        "revision",
        "declared_license",
        "evidence",
        "note"
      ],
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sdf": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "unverified",
                  "recorded"
                ]
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "declared_license": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "package": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                        }
                      },
                      "required": [
                        "package",
                        "path"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "external": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                        }
                      },
                      "required": [
                        "external",
                        "path"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "source_url",
              "revision",
              "declared_license",
              "evidence",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "sdf",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "local_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "storage": {
      "enum": ["existing", "vendored"]
    },
    "inventory_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "asset_set_id",
    "model_root",
    "provenance",
    "models",
    "files",
    "local_changes",
    "storage",
    "inventory_note"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
