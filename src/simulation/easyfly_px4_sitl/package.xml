<?xml version="1.0"?>
<package format="3">
  <name>easyfly_px4_sitl</name>
  <version>0.1.0</version>
  <description>PX4 SITL launch files and airframe models for EasyFly</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>mesa-utils</exec_depend>
  <exec_depend>easyfly_gazebo_worlds</exec_depend>
  <exec_depend>easyfly_gazebo_models</exec_depend>
  <exec_depend>easyfly_gazebo_plugins</exec_depend>
  <exec_depend>easyfly_fastdds_compat</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_cmake</build_type></export>
  <exec_depend>easyfly_super_planner</exec_depend>
</package>
