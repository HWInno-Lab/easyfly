#!/usr/bin/python3
# Copyright 2026 EasyFly Project. SPDX-License-Identifier: Apache-2.0
"""Inspect shared effective backend selection without launching a component."""
import argparse
import json
import sys
from easyfly_backend_registry import loads
from easyfly_params.backends import resolve_selection, parse_layers, check_dependencies
from easyfly_params.configuration import PROFILES


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--profile', choices=PROFILES, default='base_sim')
    parser.add_argument('--algorithms-json', default='{}')
    parser.add_argument('--file', default='')
    parser.add_argument('--backends-json', default='')
    parser.add_argument('--check-dependencies', action='store_true')
    args = parser.parse_args()
    try:
        if len(args.algorithms_json) > 1024*1024: raise ValueError('algorithm configuration too large')
        file_value, cli_value = parse_layers(args.file, args.backends_json)
        result = resolve_selection(args.profile, loads(args.algorithms_json), file_value, cli_value)
        result['preflight'] = check_dependencies(result) if args.check_dependencies else dict(phase='configured', runtime_ready=False, dependencies_present=None)
        print(json.dumps(result, ensure_ascii=False, sort_keys=True, allow_nan=False))
        return 0
    except Exception as error:
        print(json.dumps(dict(error_code=getattr(error, 'code', 'unsupported_configuration'), error=str(error)), ensure_ascii=False))
        return 2


if __name__ == '__main__':
    sys.exit(main())
