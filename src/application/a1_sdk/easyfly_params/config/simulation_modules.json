    {
      "id": "ellipse",
      "title": "椭圆检测",
      "flag": "ellipse_enabled",
      "requires": []
    },
    {
      "id": "color_line",
      "title": "彩线检测",
      "flag": "color_line_enabled",
      "requires": []
