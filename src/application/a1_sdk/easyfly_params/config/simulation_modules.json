      "title": "多目标跟踪",
      "flag": "start_tracking",
      "requires": [
        "object_detection"
      ]
    },
    {
      "id": "single_tracking",
      "title": "单目标跟踪",
      "flag": "start_single_tracking",
      "requires": []
    },
    {
      "id": "pixel_to_3d",
      "title": "目标三维定位",
      "flag": "start_pixel_to_3d",
