<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_pybind</name>
  <version>0.1.0</version>
  <description>GIL-safe Python binding of the EasyFly C++ SDK</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <!-- Listed own code is offered only under the EasyFly license; retained third-party materials have separate terms. -->
  <license>LicenseRef-EasyFly-Restricted-1.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>easyfly_core</depend>
  <depend>pybind11_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
