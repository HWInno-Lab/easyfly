  <version>0.1.0</version>
  <description>Explicit metric visual guidance with bounded semantic and prediction envelopes</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>easyfly_msgs</exec_depend>
  <exec_depend>quadrotor_msgs</exec_depend>
