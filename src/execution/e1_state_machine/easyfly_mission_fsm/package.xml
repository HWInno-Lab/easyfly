<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_mission_fsm</name>
  <version>0.1.0</version>
  <description>E1: Versioned YAML / legacy sequential mission executor and navigation-backed search</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>easyfly_msgs</depend>
  <depend>easyfly_core</depend>
  <depend>easyfly_mission_format</depend>

  <exec_depend>easyfly_flight_control</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
