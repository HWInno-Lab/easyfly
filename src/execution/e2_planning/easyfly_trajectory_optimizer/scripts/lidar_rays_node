"""Conservative Livox hit adapter. Equal acquisition times retain distinct ray origins."""
import math
import struct


def hit_groups(message, frame, minimum, maximum, last_stamp=0):
    """Pure conversion; dropped points/groups convey no observation at all."""
    base = message.header.stamp.sec * 1000000000 + message.header.stamp.nanosec
    if (
        message.header.frame_id != frame
        or message.header.stamp.sec < 0
        or not 0 <= message.header.stamp.nanosec < 1000000000
        or base <= last_stamp
        or message.timebase != base
        or message.point_num != len(message.points)
        or not 0 < len(message.points) <= 50000
    ):
        raise ValueError("Livox frame/timebase/sequence/count")
    groups = {}
    previous = -1
    for point in message.points:
        offset = point.offset_time
        if offset < previous or offset > 200000000:
            raise ValueError("Livox acquisition offset/order")
        previous = offset
        xyz = (point.x, point.y, point.z)
        # Livox tag bits 5:4 describe return number, 3:2 and 1:0 noise confidence.
        # Only a first, unflagged physical return is accepted. No synthetic misses.
        if point.tag & 0xCF or (point.tag & 0x30) not in (0, 0x10):
            continue
        if not all(math.isfinite(value) for value in xyz):
            continue
        length = math.sqrt(sum(value * value for value in xyz))
        if not minimum < length <= maximum:
            continue
        groups.setdefault(base + offset, bytearray()).extend(
            struct.pack("<fffB3xff", *xyz, 1, minimum, maximum)
        )
    return [(stamp, bytes(groups[stamp])) for stamp in sorted(groups)]


def main():
    import rclpy
    from rclpy.node import Node
    from rclpy.qos import qos_profile_sensor_data
    from rcl_interfaces.msg import ParameterDescriptor
    from livox_ros_driver2.msg import CustomMsg
    from sensor_msgs.msg import PointCloud2, PointField

    class Adapter(Node):
        def __init__(self):
            super().__init__("lidar_rays")
            descriptor = ParameterDescriptor(read_only=True)

            def param(name, default):
                return self.declare_parameter(name, default, descriptor).value

            self.topic = param("input_topic", "")
            self.frame = param("source_frame", "")
            self.output = param("rays_topic", "/livox/lidar/rays")
            self.minimum = param("range_min", 0.0)
            self.maximum = param("range_max", 0.0)
            if (
                not self.topic.startswith("/")
                or self.output != "/livox/lidar/rays"
                or self.topic == self.output
                or not self.frame
                or self.frame.startswith("/")
                or not math.isfinite(self.minimum)
                or not math.isfinite(self.maximum)
                or not 0.1 <= self.minimum < self.maximum <= 100.0
                or self.get_parameter("use_sim_time").value
            ):
                raise ValueError(
                    "explicit wall-clock Livox topic/frame/range calibration required"
                )
            self.publisher = self.create_publisher(PointCloud2, self.output, 2)
            self.subscription = self.create_subscription(
                CustomMsg, self.topic, self.receive, qos_profile_sensor_data
            )
            self.last = 0
            self.clock_last = 0
            self.fields = [
                PointField(name=name, offset=offset, datatype=kind, count=1)
                for name, offset, kind in [
                    ("x", 0, 7),
                    ("y", 4, 7),
                    ("z", 8, 7),
                    ("return_type", 12, 2),
                    ("range_min", 16, 7),
                    ("range_max", 20, 7),
                    ("offset_time", 24, 6),
                ]
            ]

        def receive(self, message):
            current = self.get_clock().now().nanoseconds
            if current < self.clock_last:
                self.last = current  # fail closed until a genuinely newer acquisition
                self.clock_last = current
                return
            self.clock_last = current
            if len(self.get_publishers_info_by_topic(self.topic)) != 1:
                return
            try:
                groups = hit_groups(message, self.frame, self.minimum, self.maximum, self.last)
                if not groups or any(
                    not -200000000 <= current - stamp <= 1000000000 for stamp, _ in groups
                ):
                    return
            except ValueError:
                return
            base = message.timebase
            data = bytearray()
            for stamp, group in groups:
                for position in range(0, len(group), 24):
                    data.extend(group[position:position + 24])
                    data.extend(struct.pack("<I", stamp - base))
            cloud = PointCloud2()
            cloud.header = message.header
            cloud.height, cloud.width = 1, len(data) // 28
            cloud.fields = self.fields
            cloud.point_step, cloud.row_step = 28, len(data)
            cloud.data, cloud.is_dense = bytes(data), True
            self.publisher.publish(cloud)
            self.last = groups[-1][0]

    rclpy.init()
    try:
        node = Adapter()
        rclpy.spin(node)
    finally:
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
