<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_trajectory_optimizer</name>
  <version>0.1.0</version>
  <description>Bounded three-dimensional GCOPTER planning and managed trajectory execution.</description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <!-- Listed own code is offered only under the EasyFly license; retained third-party materials have separate terms. -->
  <license>LicenseRef-EasyFly-Restricted-1.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>easyfly_gcopter_core</depend>
  <depend>rclcpp</depend><depend>easyfly_msgs</depend><depend>sensor_msgs</depend>
  <depend>quadrotor_msgs</depend><depend>tf2_ros</depend><depend>tf2_eigen</depend>
  <depend>ament_index_cpp</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend><test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
