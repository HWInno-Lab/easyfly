<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>easyfly_global_planner</name>
  <version>0.1.0</version>
  <description>
    EasyFly E2: 全局规划器 (M4.2)。/occupancy_grid 上 2D A* + 视线剪枝,
    逐段 GoToWaypoint 执行 (复用 flight_control 安全链)。
  </description>
  <maintainer email="dev@easyfly.org">EasyFly Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_action</depend>
  <depend>ament_index_cpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>easyfly_msgs</depend>
  <depend>easyfly_core</depend>
  <depend>yaml-cpp</depend>
  <depend>easyfly_astar</depend>
  <depend>easyfly_grid_planner_api</depend>
  <depend>rcl_interfaces</depend>
  <exec_depend>easyfly_obstacle_avoidance</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>traj_utils</test_depend>
  <test_depend>easyfly_flight_control</test_depend>
  <test_depend>easyfly_local_planner</test_depend>
  <test_depend>easyfly_pybind</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
