+void SDFMap::importSnapshot(const vector<int8_t>& raw,const vector<int8_t>& inflated) {
+ if(raw.size()!=md_->occupancy_buffer_.size() || inflated.size()!=raw.size()) throw std::runtime_error("snapshot geometry");
+ for(size_t i=0;i<raw.size();++i)if((raw[i]!=-1 && raw[i]!=0 && raw[i]!=100) || (inflated[i]!=-1 && inflated[i]!=0 && inflated[i]!=100))throw std::runtime_error("snapshot occupancy");
+ Eigen::Vector3i lo=mp_->map_voxel_num_,hi=Eigen::Vector3i::Zero();bool changed=false;
+ // External layout is x-fastest; native SDFMap layout is z-fastest.
+ for(int z=0;z<mp_->map_voxel_num_[2];++z)for(int y=0;y<mp_->map_voxel_num_[1];++y)for(int x=0;x<mp_->map_voxel_num_[0];++x){
+  int src=x+mp_->map_voxel_num_[0]*(y+mp_->map_voxel_num_[1]*z),dst=toAddress(x,y,z);
+  if(raw[src]!=-1 && raw[src]!=0 && raw[src]!=100)throw std::runtime_error("snapshot occupancy");
+  double v=raw[src]<0?mp_->clamp_min_log_-mp_->unknown_flag_:(raw[src]==0?mp_->clamp_min_log_:mp_->clamp_max_log_);
+  char inf=inflated[src]==0?0:1;
+  if(md_->occupancy_buffer_[dst]!=v || md_->occupancy_buffer_inflate_[dst]!=inf){changed=true;Eigen::Vector3i i(x,y,z);lo=lo.cwiseMin(i);hi=hi.cwiseMax(i);}
+  md_->occupancy_buffer_[dst]=v;md_->occupancy_buffer_inflate_[dst]=inf;
+ }
+ if(changed){indexToPos(lo,md_->update_min_);indexToPos(hi,md_->update_max_);}
+ else {md_->update_min_=mp_->map_min_boundary_;md_->update_max_=mp_->map_max_boundary_;}
+ md_->reset_updated_box_=false;
+}
+}
