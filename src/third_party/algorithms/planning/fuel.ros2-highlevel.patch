+namespace fast_planner {
+void SDFMap::buildSnapshotESDF() {
+  // Snapshot imports have no streaming ROS map updater to set local bounds.
+  // Recompute the actual native ESDF over this bounded snapshot, including
+  // unknown cells as obstacles when optimistic=false.
+  md_->local_bound_min_ = Eigen::Vector3i::Zero();
+  md_->local_bound_max_ = mp_->map_voxel_num_ - Eigen::Vector3i::Ones();
+  updateESDF3d();
