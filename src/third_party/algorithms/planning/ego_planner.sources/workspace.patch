+bool EGOPlannerManager::EmergencyStop(Eigen::Vector3d stop_pos)
+{
+  Eigen::MatrixXd control_points(3, 6);
+  for (int i = 0; i < 6; i++) {
+    control_points.col(i) = stop_pos;
