+void EGOReplanFSM::publishSwarmTrajs(bool startup_pub)
+{
+  auto info = &planner_manager_->local_data_;
+
+  traj_utils::msg::Bspline bspline;
+  bspline.navigation_session_id = navigation_session_id_;
+  bspline.order = 3;
+  bspline.start_time = info->start_time_;
+  bspline.drone_id = planner_manager_->pp_.drone_id;
+  bspline.traj_id = info->traj_id_;
+
+  Eigen::MatrixXd pos_pts = info->position_traj_.getControlPoint();
+  bspline.pos_pts.reserve(pos_pts.cols());
+  for (int i = 0; i < pos_pts.cols(); ++i) {
+    geometry_msgs::msg::Point pt;
+    pt.x = pos_pts(0, i);
+    pt.y = pos_pts(1, i);
+    pt.z = pos_pts(2, i);
+    bspline.pos_pts.push_back(pt);
+  }
+
+  Eigen::VectorXd knots = info->position_traj_.getKnot();
+  // cout << knots.transpose() << endl;
+  bspline.knots.reserve(knots.rows());
+  for (int i = 0; i < knots.rows(); ++i) {
+    bspline.knots.push_back(knots(i));
+  }
+
+  if (startup_pub) {
+    multi_bspline_msgs_buf_.drone_id_from = planner_manager_->pp_.drone_id;  // zx-todo
+    const int count = static_cast<int>(multi_bspline_msgs_buf_.traj.size());
+    if (count == planner_manager_->pp_.drone_id + 1) {
+      multi_bspline_msgs_buf_.traj.back() = bspline;
+    } else if (count == planner_manager_->pp_.drone_id) {
+      multi_bspline_msgs_buf_.traj.push_back(bspline);
+    } else {
+      // ROS_ERROR("Wrong traj nums and drone_id pair!!! traj.size()=%d, drone_id=%d",
+      // static_cast<int>(multi_bspline_msgs_buf_.traj.size()), planner_manager_->pp_.drone_id);
+      RCLCPP_ERROR(
+        rclcpp::get_logger(
+          "EGOReplanFSM"), "Wrong traj nums and drone_id pair!!! traj.size()=%d, drone_id=%d",
+        static_cast<int>(multi_bspline_msgs_buf_.traj.size()), planner_manager_->pp_.drone_id);
+
+      // return plan_and_refine_success;
+    }
+    swarm_trajs_pub_->publish(multi_bspline_msgs_buf_);
+  }
+
+  broadcast_bspline_pub_->publish(bspline);
+}
