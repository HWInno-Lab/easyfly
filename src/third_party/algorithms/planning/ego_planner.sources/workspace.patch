+vector<GridNodePtr> AStar::retrievePath(GridNodePtr current)
+{
+  vector<GridNodePtr> path;
+  path.push_back(current);
+
+  while (current->cameFrom != NULL) {
+    current = current->cameFrom;
+    path.push_back(current);
+  }
+
+  return path;
+}
